page { height: 100%; background: #191238; }
.home-page { position: relative; height: 100vh; overflow: hidden; background: #191238; color: #fff7ff; }
.home-bg, .home-overlay, .decorative-overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.home-bg { z-index: 0; }
.home-overlay { z-index: 1; background: linear-gradient(180deg, rgba(22,16,58,.72) 0%, rgba(36,24,83,.38) 34%, rgba(34,24,79,.18) 55%, rgba(22,16,58,.87) 100%); }
.home-sparkles { z-index: 2; opacity: .22; pointer-events: none; }
.home-content { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: center; height: 100%; padding: calc(120rpx + env(safe-area-inset-top)) 48rpx calc(30rpx + env(safe-area-inset-bottom)); animation: home-enter 600ms ease-out both; }
.home-heading { flex-shrink: 0; width: 100%; text-align: center; }
.eyebrow { display: flex; justify-content: center; align-items: center; color: #ecdbff; font-family: Georgia, serif; font-size: 21rpx; letter-spacing: 4rpx; }
.brand-star { margin: 0 18rpx; color: #f5ceea; font-size: 17rpx; }
.title-cn { margin-top: 24rpx; color: #fff5ff; font-family: serif; font-size: 58rpx; font-weight: 600; line-height: 1.4; letter-spacing: 3rpx; text-shadow: 0 3rpx 16rpx rgba(20,10,66,.55), 0 0 26rpx rgba(220,175,255,.35); }
.subtitle { margin-top: 18rpx; color: #f1e8ff; font-size: 25rpx; line-height: 1.6; letter-spacing: 2rpx; text-shadow: 0 2rpx 8rpx rgba(24,13,68,.65); }
.subtitle.secondary { margin-top: 0; color: #e1d6f9; }
.hero-stage { position: relative; flex: 1; min-height: 0; width: 100%; max-width: 654rpx; margin: 24rpx 0 18rpx; }
.halo { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); border-radius: 50%; pointer-events: none; }
.halo-back { width: 112%; height: 95%; background: radial-gradient(ellipse, rgba(235,200,255,.48) 0%, rgba(143,116,240,.18) 47%, rgba(126,110,246,0) 72%); }
.halo-front { width: 76%; height: 80%; border: 1rpx solid rgba(243,217,255,.35); box-shadow: 0 0 55rpx rgba(192,154,255,.23), inset 0 0 42rpx rgba(233,198,255,.13); }
.hero-frame { position: absolute; top: 5%; right: 6%; bottom: 7%; left: 6%; border: 1rpx solid rgba(248,224,255,.24); border-radius: 240rpx 240rpx 28rpx 28rpx; background: linear-gradient(180deg, rgba(241,218,255,.05), rgba(48,27,106,.08)); }
.hero-character { position: absolute; z-index: 2; left: -3%; top: 0; width: 106%; height: 100%; filter: drop-shadow(0 12rpx 22rpx rgba(22,12,64,.38)); }
.hero-glow { position: absolute; z-index: 3; right: -6%; bottom: 0; left: -6%; height: 21%; background: linear-gradient(180deg, rgba(30,20,67,0), rgba(30,20,67,.65)); pointer-events: none; }
.hero-star { position: absolute; z-index: 4; color: #ffe8fa; text-shadow: 0 0 22rpx #dbb9ff; pointer-events: none; }
.star-left { top: 26%; left: 2%; font-size: 44rpx; }
.star-right { top: 63%; right: 3%; font-size: 28rpx; }
.hero-caption { position: absolute; z-index: 4; bottom: 14rpx; left: 0; width: 100%; color: #f4e7ff; font-size: 23rpx; letter-spacing: 4rpx; text-align: center; text-shadow: 0 2rpx 12rpx rgba(16,10,43,.75); }
.home-action { flex-shrink: 0; width: 100%; text-align: center; }
.test-details { display: flex; align-items: center; justify-content: center; color: #e9defa; font-size: 21rpx; line-height: 1.6; letter-spacing: 1rpx; }
.detail-dot { margin: 0 14rpx; color: #dcb0ef; }
.start-button { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 574rpx; height: 104rpx; margin: 22rpx auto 0; border: 1rpx solid rgba(255,232,255,.8); border-radius: 60rpx; background: linear-gradient(105deg, #eaa4d5 0%, #b185ee 52%, #8270ee 100%); color: #fff; font-size: 35rpx; font-weight: 600; letter-spacing: 4rpx; box-shadow: 0 12rpx 32rpx rgba(15,7,51,.38), 0 0 28rpx rgba(186,126,248,.25), inset 0 2rpx 0 rgba(255,255,255,.35); transition: transform 140ms ease, box-shadow 140ms ease; }
.start-button-pressed { transform: scale(.96); box-shadow: 0 4rpx 14rpx rgba(15,7,51,.35), inset 0 2rpx 0 rgba(255,255,255,.3); }
.home-action .start-button { width: 100%; max-width: 574rpx; }
.button-arrow { position: absolute; right: 44rpx; font-size: 38rpx; font-weight: 400; }
.button-spark { position: absolute; left: 44rpx; font-size: 23rpx; opacity: .9; }
.hint { margin-top: 18rpx; color: #d9cbea; font-size: 20rpx; line-height: 1.5; letter-spacing: 2rpx; }
@keyframes home-enter { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .home-content { animation: none; } .start-button { transition: none; } }
