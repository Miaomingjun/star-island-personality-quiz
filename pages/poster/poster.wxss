page { height: 100%; overflow: hidden; background: #17113d; }
.poster-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #17113d; color: #fff; }
.poster-stage { position: absolute; z-index: 1; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.poster-preview-viewport { position: absolute; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; }
.poster-backdrop, .poster-backdrop-shade, .poster-preview, .poster-transition { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.poster-backdrop { display: block; }
.poster-backdrop-shade { background: rgba(15, 11, 49, .68); }
.poster-preview { display: block; opacity: 0; transition: opacity 250ms ease; }
.poster-preview.is-visible { opacity: 1; }
.poster-transition { z-index: 2; display: flex; align-items: center; justify-content: center; background: rgba(15, 11, 49, .16); pointer-events: none; }
.poster-spinner { width: 48rpx; height: 48rpx; border: 3rpx solid rgba(255, 231, 251, .38); border-top-color: #fff5ff; border-radius: 50%; animation: poster-spin 900ms linear infinite; }
@keyframes poster-spin { to { transform: rotate(360deg); } }
.poster-state, .empty-state { position: relative; z-index: 2; box-sizing: border-box; width: calc(100% - 64rpx); max-height: 100%; margin: 0 auto; padding: 72rpx 42rpx 58rpx; border: 1rpx solid rgba(255,255,255,.65); border-radius: 32rpx; background: rgba(53,38,111,.92); text-align: center; box-shadow: 0 20rpx 55rpx rgba(26,17,72,.3); }
.empty-state { position: absolute; top: 50%; left: 32rpx; margin: 0; transform: translateY(-50%); }
.state-mark { color: #ffe7ad; font-size: 54rpx; }
.state-title { margin-top: 20rpx; font-size: 38rpx; font-family: serif; }
.state-copy { margin-top: 22rpx; color: rgba(255,255,255,.9); font-size: 26rpx; line-height: 1.7; }
.poster-stage-label { margin-top: 18rpx; color: rgba(255,255,255,.8); font-size: 22rpx; letter-spacing: 1rpx; }
.debug-error { display: block; margin-top: 16rpx; padding: 14rpx 16rpx; border-radius: 14rpx; background: rgba(35,22,72,.42); color: #ffe8ee; font-size: 20rpx; line-height: 1.5; text-align: left; word-break: break-all; }
.poster-actions { position: absolute; z-index: 5; right: 42rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); left: 42rpx; display: flex; gap: 18rpx; }
.poster-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; height: 76rpx; border-radius: 50rpx; font-size: 25rpx; font-weight: 600; line-height: 1; }
.poster-actions .poster-button { flex: 1; min-width: 0; margin: 0; }
.poster-button.primary { border: 1rpx solid rgba(255,230,250,.66); background: linear-gradient(90deg,rgba(178,116,190,.78),rgba(105,88,168,.84)); color: #fff; box-shadow: 0 6rpx 18rpx rgba(29,19,80,.25); }
.poster-button.secondary { border: 1rpx solid rgba(255,255,255,.55); background: rgba(35,26,78,.63); color: #fff; box-shadow: 0 6rpx 18rpx rgba(28,19,75,.2); }
.button-icon { margin-right: 10rpx; font-size: 34rpx; font-weight: 400; }
.poster-state .poster-button, .empty-state .poster-button { width: 340rpx; margin: 38rpx auto 0; }
.poster-canvas { position: fixed; left: 0; top: 0; z-index: 0; width: 375px; height: 820px; opacity: 0; pointer-events: none; }
